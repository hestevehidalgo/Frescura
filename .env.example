# Copia este archivo como .env y completa los valores (ver docs/setup-backend.md).
# El archivo .env nunca se sube a git.

# Supabase: la URL del proyecto y la clave "publishable" (pública por diseño, la protege RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# La clave de Anthropic NO va aquí: vive solo en los secretos de Supabase (ANTHROPIC_API_KEY).
